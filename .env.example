# TEDDY-XMD ULTRA — copy this file to .env and fill in your own values.
# Never commit .env or put secret keys in frontend JavaScript.

# Core server
NODE_ENV=production
PORT=3000
BOT_NAME=TEDDY-XMD ULTRA
BOT_PREFIX=.
OWNER_NAME=Teddy Tech
REPO_URL=https://github.com/Teddyxmd/TEDDY-XMD
WEBSITE_URL=https://your-website-domain.com

# MongoDB Atlas (required for persistent database/session storage)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/teddy_xmd?retryWrites=true&w=majority
MONGODB_DB=teddy_xmd

# Paystack — keep the secret key server-side only
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key
PAYSTACK_CURRENCY=KES
PAYMENT_AMOUNT=3000
PAYMENT_AMOUNT_KOBO=3000
PAIRING_PRICE_KES=30
# Optional full callback URL; defaults to the website origin + /?payment=return
# PAYSTACK_CALLBACK_URL=https://your-website-domain.com/?payment=return

# Telegram bot created with @BotFather
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
# Base URL of the main TEDDY-XMD sessions server
PAIRING_API_URL=http://127.0.0.1:3000
