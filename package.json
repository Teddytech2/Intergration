{
  "name": "teddy-xmd",
  "version": "4.0.0",
  "description": "TEDDY-XMD \u2014 a self-hosted WhatsApp multi-device bot built on Baileys with AI, downloads, fun, group moderation, tools, and automation.",
  "type": "module",
  "main": "sessions.js",
  "author": "Teddy Tech",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/Teddyxmd/TEDDY-XMD",
